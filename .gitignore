# Ignore runtime logs and generated npm/package-manager logs.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Ignore installed dependencies, build output and local environment files.
node_modules
dist
dist-ssr
*.local

# Ignore editor/project metadata that should not be committed.
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
